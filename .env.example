# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Structured Answer Grading AI (DeepSeek or any OpenAI-compatible API)
# GRADING_AI_PROVIDER: auto | deepseek | openai-compatible | gemini
GRADING_AI_PROVIDER="auto"

# Option A: DeepSeek API
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# Option B: Any other OpenAI-compatible AI API (Qwen/DashScope, Moonshot, OpenAI, SiliconFlow, etc.)
GRADING_AI_API_KEY=""
GRADING_AI_BASE_URL=""
GRADING_AI_MODEL=""
GRADING_AI_LABEL="自定义 AI 接口"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AUTH_TOKEN_SECRET: Optional HMAC secret for signing user session tokens.
AUTH_TOKEN_SECRET="CHANGE_ME_SESSION_SECRET"
